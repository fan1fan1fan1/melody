<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面组件：单行播放缩略图（光盘 + 歌名/作者 + 上一首 / 播放暂停 / 下一首） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mini_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="58dp">

        <!-- 暂停 / 未播放时的静态光盘 -->
        <ImageView
            android:id="@+id/widget_disc_static"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_disc" />

        <!-- 播放时旋转的光盘 -->
        <ProgressBar
            android:id="@+id/widget_disc_spin"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_spin_ring"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Melody"
            android:textColor="#F1EEFA"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="还没有在播放"
            android:textColor="#9E99B8"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_icon_bg"
            android:contentDescription="@null"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_prev" />

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@null"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_icon_bg"
            android:contentDescription="@null"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
